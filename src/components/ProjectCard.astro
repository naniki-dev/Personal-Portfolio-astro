---
interface Props {
  title: string;
  description: string;
  image: string;
  alt: string;
  tags: string[];
  demoUrl: string;
}

const { title, description, image, alt, tags, demoUrl } = Astro.props;
---

<article class="project-card">
  <div class="project-thumb">
    <img src={image} alt={alt} />
  </div>
  <div class="project-card-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <ul class="tech-tags">
      {tags.map(tag => <li>{tag}</li>)}
    </ul>
    <div class="project-links">
      <a href={demoUrl} target="_blank" rel="noopener">Click for Live Demo</a>
    </div>
  </div>
</article>