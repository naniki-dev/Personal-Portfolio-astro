---
interface Props {
  title: string;
  description: string;
  image: string;
  alt: string;
  tags: string[];
  demoUrl: string;
}

const { title, description, image, alt, tags, demoUrl } = Astro.props as Props;
---

<a href={demoUrl} target="_blank" rel="noopener" class="project-row">
  <div class="project-row-thumb">
    <img src={image} alt={alt} />
  </div>
  <div class="project-row-text">
    <p class="project-row-title">{title}</p>
    <p class="project-row-desc">{description}</p>
    <span class="project-row-desc-tip">{description}</span>
  </div>
  <ul class="project-row-tags">
    {tags.map(tag => <li>{tag}</li>)}
  </ul>
  <i class="ti ti-arrow-right project-row-arrow" aria-hidden="true"></i>
</a>